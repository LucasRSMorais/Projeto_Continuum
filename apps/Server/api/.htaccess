RewriteRule ^logout\.php$ auth/logout.php [END,QSA]
RewriteRule ^session\.php$ auth/session.php [END,QSA]
RewriteRule ^verificar2FA_paciente\.php$ auth/verificar2FA_paciente.php [END,QSA]
RewriteRule ^verify-2fa\.php$ auth/verify-2fa.php [END,QSA]

RewriteRule ^alteraSenha\.php$ password/alteraSenha.php [END,QSA]
RewriteRule ^email\.php$ password/email.php [END,QSA]
RewriteRule ^email2\.php$ password/email2.php [END,QSA]
RewriteRule ^enviarSenha\.php$ password/enviarSenha.php [END,QSA]
RewriteRule ^novaSenhaDoPaciente\.php$ password/novaSenhaDoPaciente.php [END,QSA]
RewriteRule ^senha\.php$ password/senha.php [END,QSA]
RewriteRule ^verificar\.php$ password/verificar.php [END,QSA]
RewriteRule ^verificar2\.php$ password/verificar2.php [END,QSA]

RewriteRule ^atualizartelefone\.php$ patients/atualizartelefone.php [END,QSA]
RewriteRule ^atualizar_endereco_paciente\.php$ patients/atualizar_endereco_paciente.php [END,QSA]
