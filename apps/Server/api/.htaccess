RewriteRule ^confirmar_deleta\.php$ patients/confirmar_deleta.php [END,QSA]
RewriteRule ^consentimentos_paciente\.php$ patients/consentimentos_paciente.php [END,QSA]
RewriteRule ^consultar\.php$ patients/consultar.php [END,QSA]
RewriteRule ^endereco\.php$ patients/endereco.php [END,QSA]
RewriteRule ^exportar\.php$ patients/exportar.php [END,QSA]
RewriteRule ^primeiro_acesso_paciente\.php$ patients/primeiro_acesso_paciente.php [END,QSA]
RewriteRule ^register_paciente\.php$ patients/register_paciente.php [END,QSA]
RewriteRule ^revoga_conta\.php$ patients/revoga_conta.php [END,QSA]

RewriteRule ^register\.php$ staff/register.php [END,QSA]
RewriteRule ^Cards/get_dashboard_cards\.php$ dashboard/get_dashboard_cards.php [END,QSA]
