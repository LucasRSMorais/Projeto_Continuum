# Local PHP server outside Docker: use DB_HOST=localhost.
# Inside Docker Compose, the backend receives DB_HOST=db from apps/docker-compose.yml.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=railway
DB_USER=continuum_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Set this only when the database provider supplies a CA certificate for TLS.
DB_SSL_CA=

# Configure secret credentials outside Git.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Base64-encoded 32-byte key for AES-256-GCM encryption of patient sex and ethnicity.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
PATIENT_DATA_ENCRYPTION_KEY=
