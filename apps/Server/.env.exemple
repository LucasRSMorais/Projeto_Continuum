
# Configurações da Base de Dados (Valores padrão para executar via Docker)
DB_HOST=db
DB_NAME=continuum_db
DB_USER=continuum_user
DB_PASSWORD=continuum_password
# Se o sistema for rodar via XAMPP/Laragon fora do Docker, mude o DB_HOST para localhost:
# DB_HOST=localhost

# Configuração da API do Resend
RESEND_API_KEY=

# Configurações de Servidor SMTP (Exemplo: Mailtrap, Gmail, etc.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=