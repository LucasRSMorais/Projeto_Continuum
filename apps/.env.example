# Copy to apps/.env (ignored by Git) and use unique, randomly generated values.
# Never commit apps/.env or place real credentials in this example file.
# Existing MySQL volumes keep their stored users/passwords until explicitly rotated.
DB_ROOT_PASSWORD=
DB_APP_USER=continuum_user
DB_APP_PASSWORD=

# Optional hosted database connection. Non-empty DB_* values take precedence
# over the local Docker database. Keep these blank to use the Compose service.
APP_ENV=development
DB_HOST=
DB_PORT=3306
DB_NAME=railway
DB_USER=
DB_PASSWORD=
DB_SSL_CA=

# Optional host ports. Both services bind to 127.0.0.1 only.
API_PUBLISHED_PORT=8000
DB_PUBLISHED_PORT=3306

# Optional for local login and password-recovery email delivery.
RESEND_API_KEY=
